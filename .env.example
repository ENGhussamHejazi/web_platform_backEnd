# ─── Database ───────────────────────────────────────────────
# Points at the docker-compose Postgres (host port 5435).
DATABASE_URL="postgresql://souq:souq_dev_password@localhost:5435/souq_syria?schema=public"
# Unpooled connection used by `prisma migrate` (required on Neon; may equal
# DATABASE_URL for a plain local Postgres).
DIRECT_URL="postgresql://souq:souq_dev_password@localhost:5435/souq_syria?schema=public"
# Optional: your provider's storage cap in MB (e.g. Neon plan limit). When set,
# the مراقبة النظام dashboard shows a usage bar and flags when you're near it.
DB_STORAGE_LIMIT_MB=""

# ─── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS="http://localhost:5173"

# ─── Auth / JWT ─────────────────────────────────────────────
# Generate strong secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

# ─── Super Admin seed (used by `npm run seed`) ──────────────
SUPER_ADMIN_EMAIL="admin@souq-syria.com"
SUPER_ADMIN_PASSWORD="Admin@12345"
SUPER_ADMIN_NAME="مدير المنصة"

# ─── File uploads ───────────────────────────────────────────
# STORAGE_DRIVER: local | cloudinary
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"
# Public base URL used to build absolute image links (local driver only).
PUBLIC_BASE_URL="http://localhost:4000"

# Cloudinary — required when STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="souq-syria"

# ─── SMS notifications (optional; stub by default) ──────────
# SMS_DRIVER: log | syriatel | mtn  (only "log" implemented for now)
SMS_DRIVER="log"
SMS_SENDER_ID="SouqSyria"
# SMS_API_KEY=""
# SMS_API_URL=""

# ─── Payments ───────────────────────────────────────────────
# Comma-separated enabled providers. cod is always available.
PAYMENT_PROVIDERS="cod"

# ─── Mail (store application notifications) ─────────────────
# MAIL_DRIVER: log | smtp
# "log" needs no email account and prints password-reset links in the backend
# console. To send from a personal Gmail account, use smtp.gmail.com with a
# Google App Password (never your normal Google password).
MAIL_DRIVER="log"
MAIL_HOST=""
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM_ADDRESS="youraccount@gmail.com"
MAIL_FROM_NAME="Platform Store Applications"

# Base URL used to build links inside emails (application status page, etc).
FRONTEND_BASE_URL="http://localhost:5173"

# ─── Captcha (guest order confirmation) ──────────────────────
# Cloudflare Turnstile secret key (dashboard.cloudflare.com → Turnstile).
# Guest checkout captcha verification is skipped entirely when unset, so
# local dev works without it — set this in production.
TURNSTILE_SECRET_KEY=""
